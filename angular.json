{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "ng-card-table": {
      "projectType": "library",
      "root": "projects/ng-card-table",
      "sourceRoot": "projects/ng-card-table/src",
      "prefix": "ct",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ng-card-table/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ng-card-table/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ng-card-table/tsconfig.spec.json",
            "runnerConfig": "vitest-base.config.mts",
            "coverageThresholds": {
              "statements": 100,
              "branches": 100,
              "functions": 100,
              "lines": 100
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ng-card-table/**/*.ts",
              "projects/ng-card-table/**/*.html"
            ]
          }
        }
      }
    }
  }
}
